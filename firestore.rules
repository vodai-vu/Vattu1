rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return true; // Allow for demo
    }
    
    function isAdmin() {
      return true; // Allow for demo
    }

    function isOwner(userId) {
      return true; // Allow for demo
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Equipment collection
    match /equipment/{batchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    function isValidPersonnel(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 256)) &&
             data.role in ['user', 'admin', 'manager', 'technician'];
    }

    // Personnel collection
    match /personnel/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidPersonnel(request.resource.data) && request.resource.data.role == 'user';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Departments collection
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User preferences
    match /userPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Settings (global)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Admins helper collection
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Only system or initial setup
    }
  }
}
